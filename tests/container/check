#!/usr/bin/env bash
set -euo pipefail
if [ "$#" -ne 0 ]; then
    printf '%s\n' 'Stock checks do not accept arguments.' >&2
    exit 2
fi
checkout=$(CDPATH='' cd -- "$(dirname -- "$0")/../.." && pwd)
# shellcheck source=tests/container/stock
source "${checkout}/tests/container/stock"
: "${MARKDOWN_IMAGE:?The Makefile declares MARKDOWN_IMAGE}"
: "${SHELLCHECK_IMAGE:?The Makefile declares SHELLCHECK_IMAGE}"
stock_begin "${checkout}"
markdown_image=
shellcheck_image=
stock_image markdown_image "${MARKDOWN_IMAGE}"
stock_image shellcheck_image "${SHELLCHECK_IMAGE}"
stock_readonly "${shellcheck_image}" /bin/shellcheck -x -P SCRIPTDIR -- \
    cache-command tests/test_cache_command tests/container/check tests/container/stock
STOCK_NETWORK=bridge stock_run "${markdown_image}" -- sh -ec '
    mkdir -p /scratch/markdown
    cp tests/container/package.json tests/container/package-lock.json /scratch/markdown/
    npm ci --prefix /scratch/markdown --ignore-scripts --no-audit --no-fund --maxsockets=1
    /scratch/markdown/node_modules/.bin/markdownlint-cli2
    bash -n cache-command
    bash -n tests/test_cache_command
    bash -n tests/container/check
    bash -n tests/container/stock
    sh -n tests/container/check
    ./tests/test_cache_command --interleaved
    ./tests/test_cache_command
'
stock_finish
